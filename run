#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
if [[ -z "$mode" ]]; then
  printf '%s\n' 'Usage: ./run prepare | dump | restore | enroll | payment | race | <report> | path/to/query.sql' >&2
  exit 2
fi

database_url="${CMSC127_DATABASE_URL:-}"
if [[ -z "$database_url" ]]; then
  printf '%s\n' 'Set CMSC127_DATABASE_URL before running the harness.' >&2
  exit 2
fi

case "$mode" in
  prepare)
    if [[ ! -f load.sql ]]; then
      printf '%s\n' 'Add load.sql before running the Lab 1 cases.' >&2
      exit 2
    fi
    psql "$database_url" --set ON_ERROR_STOP=1 --file load.sql
    ;;
  dump|backup)
    backup_file="${CMSC127_BACKUP_FILE:-}"
    if [[ -z "$backup_file" ]]; then
      printf '%s\n' 'Set CMSC127_BACKUP_FILE before running backup.' >&2
      exit 2
    fi
    pg_dump --format=custom --file "$backup_file" "$database_url"
    ;;
  restore)
    backup_file="${CMSC127_BACKUP_FILE:-}"
    if [[ -z "$backup_file" || ! -f "$backup_file" ]]; then
      printf '%s\n' 'Set CMSC127_BACKUP_FILE to an existing backup.' >&2
      exit 2
    fi
    pg_restore --clean --if-exists --no-owner --dbname "$database_url" "$backup_file"
    ;;
  enroll|payment|race)
    python_executable="${CMSC127_PYTHON:-python}"
    if command -v cygpath >/dev/null 2>&1; then
      python_executable="$(cygpath -u "$python_executable")"
    fi
    exec "$python_executable" answers/operations.py "$mode" "${@:2}"
    ;;
  *)
    report_file="reports/$mode.sql"
    if [[ "$mode" == */* || "$mode" == *.sql ]]; then
      report_file="$mode"
    fi
    if [[ ! -f "$report_file" ]]; then
      printf 'Unknown report or query file: %s\n' "$mode" >&2
      printf '%s\n' 'Usage: ./run prepare | dump | restore | enroll | payment | race | <report> | path/to/query.sql' >&2
      exit 2
    fi
    python_executable="${CMSC127_PYTHON:-python}"
    if command -v cygpath >/dev/null 2>&1; then
      python_executable="$(cygpath -u "$python_executable")"
    fi
    exec "$python_executable" connection.py "$report_file"
    ;;
esac
